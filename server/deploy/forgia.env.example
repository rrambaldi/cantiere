# Configurazione del server cantiere forgia.
# Sviluppo: copia in server/.env (lo leggono npm start e forgia-admin).
# Produzione: /etc/forgia/forgia.env, letto dalla unit systemd (EnvironmentFile=).
# Una variabile già presente nell'ambiente vince sul valore scritto qui.

# sqlite:<file> oppure postgres://... (per PostgreSQL: npm install pg)
FORGIA_DATABASE_URL=sqlite:forgia.db
# Ascolta solo in locale: il TLS lo fa il reverse proxy.
FORGIA_BIND=127.0.0.1:8765
# Host pubblico dietro il proxy, ammesso dal controllo degli host di /mcp.
# Solo il nome (es. esempio.it), senza schema né percorso.
FORGIA_PUBLIC_HOST=
# forzato | leggero | off
FORGIA_MODALITA_RESOCONTO=forzato
FORGIA_SOGLIA_STRUMENTI=3
FORGIA_HINT_MAX=3
FORGIA_INATTIVITA_MINUTI=30
FORGIA_RETENTION_GIORNI=180
# Richieste al minuto per token (REST + MCP).
FORGIA_RATE_LIMIT=120
# Byte massimi del corpo di una richiesta.
FORGIA_MAX_BODY=65536
